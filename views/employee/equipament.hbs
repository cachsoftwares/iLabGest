<div class="modal" id="equipament-update-photo--modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">Atualizar Foto</p>
            <button class="delete" aria-label="close"></button>
        </header>

        <section class="modal-card-body">
            <form action="/employee/equipament/update/photo" method="post" id="equipament-update-photo--form" enctype="multipart/form-data">

                <input type="hidden" name="updateEquipamentId" id="updateEquipamentPhotoId">

                <div class="columns is-multiline">

                    <div class="column is-12">
                        <div id="input-photo--content" class="file has-name is-boxed is-centered">
                            <label class="file-label">
                                <input class="file-input" type="file" name="updateEquipamentPhoto" accept="image/*" />
                                <span class="file-cta">
                                    <span class="file-icon">
                                        <i class="bx bx-cloud-upload bx-sm"></i>
                                    </span>
                                    <span class="file-label"> Escolha </span>
                                </span>
                                <span class="file-name has-text-centered"> Escolha uma foto </span>
                                <input type="hidden" name="updateEquipamentPhotoText" id="updateEquipamentPhotoText">
                            </label>
                        </div>
                    </div>

                </div>

            </form>
        </section>

        <footer class="modal-card-foot">
            <div class="buttons is-full-width is-flex is-justify-content-space-between">
                <button class="button">Cancelar</button>
                <button type="submit" form="equipament-update-photo--form" class="button is-primary">Atualizar</button>
            </div>
        </footer>
    </div>
</div>

<script>

    updateEquipamentId = document.querySelector('input#updateEquipamentId')
    updateEquipamentTitle = document.querySelector('input#updateEquipamentTitle')
    updateEquipamentStatus = document.querySelector('select#updateEquipamentStatus')
    updateEquipamentCategory = document.querySelector('select#updateEquipamentCategory')
    updateEquipamentPrice = document.querySelector('input#updateEquipamentPrice')
    updateEquipamentSupplier = document.querySelector('input#updateEquipamentSupplier')
    updateEquipamentBrand = document.querySelector('input#updateEquipamentBrand')
    updateEquipamentNote = document.querySelector('textarea#updateEquipamentNote')
    updateEquipamentUseFulLife = document.querySelector('input#updateEquipamentUseFulLife')
    updateEquipamentPurchaseDate = document.querySelector('input#updateEquipamentPurchaseDate')
    updateEquipamentManufaturingDate = document.querySelector('input#updateEquipamentManufaturingDate')
    updateEquipamentLaboratory = document.querySelector('select#updateEquipamentLaboratory')

    function equipamentUpdateSetData(id, title, status, category, price, supplier, brand, note, useFulLife, purchaseDate, manufaturingDate, laboratory) {

        updateEquipamentId.value = id
        updateEquipamentTitle.value = title
        updateEquipamentStatus.value = status
        updateEquipamentCategory.value = category
        updateEquipamentPrice.value = price
        updateEquipamentSupplier.value = supplier
        updateEquipamentBrand.value = brand
        updateEquipamentNote.value = note
        updateEquipamentUseFulLife.value = useFulLife
        updateEquipamentPurchaseDate.value = purchaseDate
        updateEquipamentManufaturingDate.value = manufaturingDate
        updateEquipamentLaboratory.value = laboratory
    }

    updateEquipamentPhotoId = document.querySelector('input#updateEquipamentPhotoId')

    function equipamentUpdatePhotoSetData(id) {

        updateEquipamentPhotoId.value = id
    }
</script>

<script>
  const fileInput = document.querySelector("#input-photo--content input[type=file]");
  fileInput.onchange = () => {
    if (fileInput.files.length > 0) {
      const fileName = document.querySelector("#input-photo--content .file-name");
      const fileNameInput = document.querySelector('input#updateEquipamentPhotoText')
      fileName.textContent = fileInput.files[0].name;
      fileNameInput.value = fileInput.files[0].name;
    }
  };
</script>

<script src="/js/components/modal.module.js"></script>