<section id="equipaments" class="section">

    <div class="container">

        <header>
            <div class="is-flex is-align-items-center is-justify-content-space-between">

                <h4 class="has-text-link title is-size-4-mobile">Gestão de Equipamentos</h4>

                <button class="button is-small is-primary js-modal-trigger" data-target="equipament-create--modal">
                    <span class="is-hidden-desktop">
                        <i class="bx bx-plus bx-sm"></i>
                    </span>
                    <span class="is-hidden-touch">
                        Novo Equipamento
                    </span>
                </button>

            </div>
            <hr>
        </header>

        <div class="content">
            <div class="columns">
                {{#each equipaments}}
                <div class="column is-12-mobile is-4-tablet is-3-desktop">
                    <div class="card">
                        <div class="card-image">
                            <figure class="image is-4by3">
                                <img src="https://bulma.io/assets/images/placeholders/1280x960.png"
                                    alt="Placeholder image" />
                            </figure>
                        </div>
                        <div class="card-content">
                            <div class="media">
                                <div class="media-left">
                                    <figure class="image is-48x48">
                                        <img src="https://bulma.io/assets/images/placeholders/96x96.png"
                                            alt="Placeholder image" />
                                    </figure>
                                </div>
                                <div class="media-content">
                                    <p class="title is-4">John Smith</p>
                                    <p class="subtitle is-6">@johnsmith</p>
                                </div>
                            </div>

                            <div class="content">
                                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus nec
                                iaculis mauris. <a>@bulmaio</a>. <a href="#">#css</a>
                                <a href="#">#responsive</a>
                                <br />
                                <time datetime="2016-1-1">11:09 PM - 1 Jan 2016</time>
                            </div>
                        </div>
                        <footer class="card-footer is-overflow-hidden">
                            <a href="#" class="card-footer-item is-flex is-gap-1 is-clickable is-size-7">
                                <i class="bx bxs-camera"></i>
                                <span>Foto</span>
                            </a>
                            <a href="#" class="card-footer-item is-flex is-gap-1 is-clickable is-size-7">
                                <i class="bx bxs-pencil"></i>
                                <span>Dados</span>
                            </a>
                            <button form="equipament-delete--form" type="submit" class="card-footer-item is-flex is-gap-1 is-clickable is-size-7 has-background-danger-90 has-text-danger-50">
                                <i class="bx bxs-trash"></i>
                                <span>Del.</span>
                            </button>
                        </footer>
                    </div>
                </div>
                <div class="is-hidden">
                    <form id="equipament-delete--form" action="/employee/equipament/delete/{{_id}}" method="post"></form>
                </div>
                {{else}}
                <p class="has-text-centered is-full-width has-text-info">Sem Equipamentos</p>
                {{/each}}
            </div>
        </div>

    </div>

</section>

<div class="modal" id="equipament-create--modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">Cadastar Equipamento</p>
            <button class="delete" aria-label="close"></button>
        </header>

        <section class="modal-card-body">
            <form action="/employee/equipament/create" method="post" id="equipament-create--form">

                <div class="columns is-mobile is-multiline">

                    <div class="column is-12-mobile is-8-tablet is-8-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentTitle">Título</label>
                            <div class="control">
                                <input name="title" id="createEquipamentTitle" class="input" type="text"
                                    placeholder="ex.: Router">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-4-tablet is-4-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentPrice">Preço (AOA)</label>
                            <div class="control">
                                <input name="price" id="createEquipamentPrice" class="input" type="number"
                                    placeholder="ex.: 100.000">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-6-tablet is-6-desktop">
                        <div class="field">
                            <label for="createEquipamentStatus" class="label">Estado</label>
                            <div class="select is-fullwidth">
                                <select name="status" id="createEquipamentStatus">
                                    <option selected value="Novo">Novo</option>
                                    <option value="Bom">Bom</option>
                                    <option value="Reciclado">Reciclado</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-6-tablet is-6-desktop">
                        <div class="field">
                            <label for="createEquipamentCategory" class="label">Categoria</label>
                            <div class="select is-fullwidth">
                                <select name="category" id="createEquipamentCategory">
                                    <option selected value="Desktop">Desktop</option>
                                    <option value="Laptop">Laptop</option>
                                    <option value="Router">Router</option>
                                    <option value="Mouse">Mouse</option>
                                    <option value="Teclado">Teclado</option>
                                    <option value="Monitor">Monitor</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-4-tablet is-4-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentBrand">Marca</label>
                            <div class="control">
                                <input name="brand" id="createEquipamentBrand" class="input" type="text"
                                    placeholder="ex.: HP, DELL, Cisco...">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-8-tablet is-8-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentSupplier">Fornecedor</label>
                            <div class="control">
                                <input name="supplier" id="createEquipamentSupplier" class="input" type="text"
                                    placeholder="ex.: NCR, ISB, Infornet...">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-4-tablet is-4-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentPurchaseDate">Data de Aquisição</label>
                            <div class="control">
                                <input name="purchaseDate" id="createEquipamentPurchaseDate" class="input" type="date">
                            </div>
                        </div>
                    </div>

                    <div class="column is-6-mobile is-4-tablet is-4-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentManufaturingDate">Fabrico</label>
                            <div class="control">
                                <input name="manufaturingDate" id="createEquipamentManufaturingDate" class="input"
                                    max="2026" type="number" placeholder="ex.: 2015">
                            </div>
                        </div>
                    </div>

                    <div class="column is-6-mobile is-4-tablet is-4-desktop">
                        <div class="field">
                            <label class="label" for="createEquipamentUseFulLife">Vida Útil</label>
                            <div class="control">
                                <input name="useFulLife" id="createEquipamentUseFulLife" class="input" min="1"
                                    type="number" placeholder="ex.: 3 anos">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12">
                        <div class="field">
                            <label for="createEquipamentLaboratory" class="label">Laboratório</label>
                            <div class="select is-fullwidth">
                                <select name="laboratory" id="createEquipamentLaboratory">
                                    {{#each laboratories}}
                                    <option value="{{_id}}">{{title}}</option>
                                    {{else}}
                                    <option disabled selected>Sem Laboratórios!</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="column is-12">
                        <div class="field">
                            <label class="label" for="createEquipamentNote">Anotações</label>
                            <div class="control">
                                <textarea class="textarea" name="note" id="createEquipamentNote"
                                    placeholder="ex.: escreve o que julga importante"></textarea>
                            </div>
                        </div>
                    </div>

                </div>

            </form>
        </section>

        <footer class="modal-card-foot">
            <div class="buttons is-full-width is-flex is-justify-content-space-between">
                <button class="button">Cancelar</button>
                <button type="submit" form="equipament-create--form" class="button is-primary">Cadastar</button>
            </div>
        </footer>
    </div>
</div>


<div class="modal" id="equipament-update--modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">Atualizar Equipamento</p>
            <button class="delete" aria-label="close"></button>
        </header>

        <section class="modal-card-body">
            <form action="/employee/equipament/update" method="post" id="equipament-update--form">

                <input type="hidden" name="updateEquipamentId" id="updateEquipamentId">

                <div class="columns is-multiline">

                    <div class="column is-12">
                        <div class="field">
                            <label class="label">Título</label>
                            <div class="control">
                                <input name="updateEquipamentTitle" id="updateEquipamentTitle" class="input" type="text"
                                    placeholder="ex.: ILab-1">
                            </div>
                        </div>
                    </div>

                    <div class="column is-12">
                        <div class="field">
                            <label for="updateEquipamentArea" class="label">Área</label>
                            <div class="select is-fullwidth">
                                <select name="updateEquipamentArea" id="updateEquipamentArea">
                                    <option value="Informática">Informática</option>
                                    <option value="Telecomunicações">Telecomunicações</option>
                                    <option value="Eletrónica">Eletrónica</option>
                                    <option value="Programação">Programação</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>

            </form>
        </section>

        <footer class="modal-card-foot">
            <div class="buttons is-full-width is-flex is-justify-content-space-between">
                <button class="button">Cancelar</button>
                <button type="submit" form="equipament-update--form" class="button is-primary">Atualizar</button>
            </div>
        </footer>
    </div>
</div>

<script>

    updateEquipamentId = document.querySelector('input#updateEquipamentId')
    updateEquipamentTitle = document.querySelector('input#updateEquipamentTitle')
    updateEquipamentArea = document.querySelector('select#updateEquipamentArea')

    function equipamentUpdateSetData(id, title, area) {

        updateEquipamentId.value = id
        updateEquipamentTitle.value = title
        updateEquipamentArea.value = area
    }
</script>

<script src="/js/components/modal.module.js"></script>