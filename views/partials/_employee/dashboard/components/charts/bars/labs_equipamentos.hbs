<div class="column is-11-mobile is-6-tablet is-6-desktop">
    <div class="box">
        <canvas id="chartBarsLabsEquipamentos" data-chart="{{json charts.laboratories}}"></canvas>
    </div>
</div>

<script>

    const chartBarsLabsEquipamentos = document.querySelector('#chartBarsLabsEquipamentos');
    const chartLaboratoryData = JSON.parse(chartBarsLabsEquipamentos.dataset.chart);

    new Chart(chartBarsLabsEquipamentos, {
        type: 'bar',
        data: {
            labels: chartLaboratoryData.labels,
            datasets: [{
                label: 'QTD Equip.',
                data: chartLaboratoryData.data,
                borderWidth: 1,
                backgroundColor: ['#777', '#f8f8f8', '#d8d8d8']
            }]
        }/*,
        options: {
            display: false,
            scales: {
                y: {
                    display: false
                }
            }
        }*/
    });
</script>