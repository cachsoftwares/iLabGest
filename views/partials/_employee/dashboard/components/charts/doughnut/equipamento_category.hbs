<div class="column is-11-mobile is-8-tablet is-3-desktop">
    <div class="box">
        <canvas id="chartDoughnutEquipamentosStatus" data-chart="{{json charts.categories}}"></canvas>
    </div>
</div>

<script>

    const chartDoughnutEquipamentosStatus = document.querySelector('#chartDoughnutEquipamentosStatus');
    const chartCategoryData = JSON.parse(chartDoughnutEquipamentosStatus.dataset.chart);

    new Chart(chartDoughnutEquipamentosStatus, {
        type: 'doughnut',
        data: {
            labels: chartCategoryData.labels,
            datasets: [{
                label: '',
                data: chartCategoryData.data,
                borderWidth: 1,
                backgroundColor: ['#777', '#f8f8f8', '#d8d8d8', '#999', '#bbb', '#aaa']
            }]
        },
        options: {
            display: false,
            scales: {
                y: {
                    display: false
                }
            }
        }
    });
</script>