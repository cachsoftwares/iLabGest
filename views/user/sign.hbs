<section id="sign-content" class="is-full-height is-flex is-align-items-center">
    <div class="container">

        <div class="columns is-centered is-multiline" id="signin">
            <div class="column is-10-mobile is-offset-1-mobile is-4-tablet is-3-desktop box">

                <div class="is-size-4 has-text-weight-semibold has-text-centered">
                    <span>Entrar</span>
                </div>

                <div class="inputs mt-6">
                    <form method="post" action="/user/sign/in">

                        <div class="input-item mt-3">
                            <input class="input" type="tel" name="signinTel" id="signinTel" placeholder="telefone" maxlength="11"  />
                        </div>

                        <div class="input-item mt-3">
                            <input class="input" type="password" name="signinPwd" id="signinPwd" placeholder="senha"  />
                        </div>

                        <div class="input-item">
                            <button type="submit" class="button is-fullwidth is-primary mt-4">Entrar</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
        
    </div>
</section>